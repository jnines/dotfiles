#!/usr/bin/env bash
set -e

rebuild() {
	local repo="$HOME/git/plasma-desktop"
	local patch="$HOME/git/patches/plasma-desktop/0001-Compact-tasks.patch"
	local dest="/usr/lib/qt6/plugins/plasma/applets/org.kde.plasma.taskmanager.so"
	local built="$HOME/git/plasma-desktop/build/lib/plugins/plasma/applets/org.kde.plasma.taskmanager.so"
	local backup="${dest}.distro"

	if [[ ! -d "$repo" ]]; then
		mkdir -p "$HOME/git"
		git clone https://invent.kde.org/plasma/plasma-desktop.git "$repo"
	fi

	cd "$repo" || exit 1
	read -r _pkg version < <(pacman -Q plasma-desktop)
	local tag="v${version%%-*}"
	git fetch --tags

	if ! git rev-parse --verify --quiet "refs/tags/$tag" >/dev/null; then
		printf 'ERROR: Tag %s not found %s\n' \
			"$tag" "$version" >&2
		exit 1
	fi

	if [[ ! -f "$patch" ]]; then
		printf 'ERROR: Patch missing: %s\n' "$patch" >&2
		exit 1
	fi

	git switch --detach --force "$tag"
	git apply --check "$patch"
	git apply "$patch"
	rm -rf build
	mkdir build
	cd build || exit 1

	cmake .. -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=.

	ninja org.kde.plasma.taskmanager
	ninja applets/taskmanager/install/strip

	sudo mv "$dest" "$backup"
	sudo cp -f "$built" "$dest"

	sudo chown root:root "$dest"
}
rebuild
rkde
